generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  CREATOR
  BUSINESS
}

enum VerificationStatus {
  UNSUBMITTED
  PENDING
  APPROVED
  REJECTED
  REQUIRES_INFO
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  CLOSED
  COMPLETED
  CANCELLED
}

enum CollaborationStatus {
  APPLIED
  NEGOTIATING
  OFFERED
  ACCEPTED
  IN_PROGRESS
  DELIVERABLE_SUBMITTED
  REVISION_REQUESTED
  APPROVED
  PAID
  DISPUTED
  CANCELLED
  DECLINED
}

enum PaymentStatus {
  PENDING
  HELD
  RELEASED
  REFUNDED
  PARTIALLY_REFUNDED
  FAILED
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  ESCALATED
}

enum DisputeOutcome {
  REFUND_BUSINESS
  PAYOUT_CREATOR
  PARTIAL_BOTH
  NO_ACTION
}

enum ReviewType {
  BUSINESS_TO_CREATOR
  CREATOR_TO_BUSINESS
}

enum DeliverableType {
  INSTAGRAM_REEL
  INSTAGRAM_STORY
  YOUTUBE_VIDEO
  YOUTUBE_SHORT
  SOCIAL_POST
  EVENT_APPEARANCE
  OTHER
}

enum ChatReportReason {
  SPAM
  HARASSMENT
  OFF_PLATFORM_CONTACT
  INAPPROPRIATE
  OTHER
}

enum NotificationChannel {
  PUSH
  EMAIL
  SMS
  IN_APP
}

// ─── Core User Models ────────────────────────────────────────────────

model User {
  id            String            @id @default(cuid())
  email         String            @unique
  phone         String?           @unique
  passwordHash  String?
  role          UserRole
  isActive      Boolean           @default(true)
  isVerified    Boolean           @default(false)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  lastLoginAt   DateTime?

  creatorProfile      CreatorProfile?
  businessProfile     BusinessProfile?
  adminProfile        AdminProfile?
  sentMessages        Message[]        @relation("SenderMessages")
  reviewsGiven        Review[]         @relation("Reviewer")
  reviewsReceived     Review[]         @relation("Reviewee")
  disputesRaised      Dispute[]        @relation("DisputeInitiator")
  disputesResolved    Dispute[]        @relation("DisputeResolver")
  reportsMade         Report[]         @relation("Reporter")
  notifications       Notification[]

  @@index([role])
  @@index([email])
  @@map("users")
}

model AdminProfile {
  id              String            @id @default(cuid())
  userId          String            @unique
  permissions     Json
  createdAt       DateTime          @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admin_profiles")
}

// ─── Creator Profile ─────────────────────────────────────────────────

model CreatorProfile {
  id                String            @id @default(cuid())
  userId            String            @unique
  displayName       String
  bio               String?
  avatarUrl         String?
  category          String
  subCategories     String[]           @default([])
  location          String?
  languages         String[]           @default(["English", "Hindi"])
  isVerified        Boolean            @default(false)
  verificationStatus VerificationStatus @default(UNSUBMITTED)
  verificationNotes String?
  verificationSubmittedAt DateTime?
  verifiedAt        DateTime?

  hourlyRate        Decimal?    @db.Decimal(10, 2)
  minProjectBudget  Decimal?    @db.Decimal(10, 2)

  panNumber         String?
  bankAccountNumber String?
  bankIfsc          String?
  bankAccountHolderName String?
  idDocumentUrl     String?
  idDocumentType    String?
  kycStatus         VerificationStatus @default(UNSUBMITTED)

  services          Service[]
  portfolioItems    PortfolioItem[]
  socialStats       Json?
  socialStatsRefreshedAt DateTime?

  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  socialConnections SocialConnection[]
  collaborations    Collaboration[]  @relation("CreatorCollaborations")
  chatThreads       ChatThread[]

  @@index([isVerified, category])
  @@index([location])
  @@map("creator_profiles")
}

model SocialConnection {
  id              String   @id @default(cuid())
  creatorId       String
  platform        String
  platformUserId  String
  username        String
  accessToken     String
  refreshToken    String?
  tokenExpiresAt  DateTime?
  followerCount   Int      @default(0)
  followingCount  Int      @default(0)
  engagementRate  Decimal? @db.Decimal(5, 2)
  avgViews        Int?     @default(0)
  audienceTopCities String[] @default([])
  lastSyncedAt    DateTime?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  creator CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@unique([platform, platformUserId])
  @@index([creatorId])
  @@map("social_connections")
}

model Service {
  id                String          @id @default(cuid())
  creatorId         String
  title             String
  description       String?
  deliverableTypes  DeliverableType[]
  price             Decimal         @db.Decimal(10, 2)
  currency          String          @default("INR")
  isActive          Boolean         @default(true)
  createdAt         DateTime        @default(now())

  creator CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([creatorId])
  @@map("services")
}

model PortfolioItem {
  id                String           @id @default(cuid())
  creatorId         String
  title             String
  description       String?
  mediaUrls         String[]
  tags               String[]        @default([])
  deliverableType   DeliverableType?
  createdAt         DateTime         @default(now())

  creator CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([creatorId])
  @@map("portfolio_items")
}

// ─── Business Profile ────────────────────────────────────────────────

model BusinessProfile {
  id                    String            @id @default(cuid())
  userId                String            @unique
  companyName           String
  companyType           String
  description           String?
  logoUrl               String?
  websiteUrl            String?
  industry              String?
  address               String?
  city                  String?
  state                 String?
  pincode               String?
  country               String?           @default("India")

  verificationStatus    VerificationStatus @default(UNSUBMITTED)
  verificationNotes     String?
  verificationSubmittedAt DateTime?
  verifiedAt            DateTime?

  gstNumber             String?
  gstCertificateUrl     String?
  businessLicenseUrl    String?
  panNumber             String?
  ownerName             String?
  ownerIdDocumentUrl    String?
  addressProofUrl       String?

  allowDirectInquiries  Boolean           @default(false)
  showInSearch          Boolean           @default(true)

  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  user                  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaigns             Campaign[]
  collaborations        Collaboration[]   @relation("BusinessCollaborations")
  chatThreads           ChatThread[]

  @@index([showInSearch, city])
  @@map("business_profiles")
}

// ─── Campaigns ──────────────────────────────────────────────────────

model Campaign {
  id                String           @id @default(cuid())
  businessId        String
  title             String
  description       String
  status            CampaignStatus  @default(DRAFT)

  budgetType        String           // "fixed", "range"
  budgetMin         Decimal?         @db.Decimal(10, 2)
  budgetMax         Decimal?         @db.Decimal(10, 2)
  budgetCurrency    String           @default("INR")

  deliverableTypes  DeliverableType[]
  deliverableDetails Json

  creatorCount      Int
  creatorCategories String[]         @default([])
  requiredPlatforms String[]
  requiredLocation  String?

  minFollowers      Int?             @default(0)
  maxFollowers      Int?
  minEngagementRate Decimal?         @db.Decimal(5, 2)

  startDate         DateTime?
  endDate           DateTime?
  applicationDeadline DateTime?
  autoCloseAfterHire Boolean         @default(false)

  allowNegotiation  Boolean          @default(true)
  maxRevisions      Int              @default(2)
  autoApproveAfterDays Int?

  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  business          BusinessProfile  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  collaborations    Collaboration[]
  chatThreads       ChatThread[]
  disputes          Dispute[]

  @@index([businessId, status])
  @@index([status, applicationDeadline])
  @@map("campaigns")
}

// ─── Collaborations ─────────────────────────────────────────────────

model Collaboration {
  id                  String             @id @default(cuid())
  campaignId          String
  creatorId           String
  businessId          String

  bidAmount           Decimal             @db.Decimal(10, 2)
  bidMessage          String?
  counterOfferAmount  Decimal?            @db.Decimal(10, 2)
  counterOfferMessage String?
  counterOfferBy      String?

  agreedAmount        Decimal             @db.Decimal(10, 2)
  status              CollaborationStatus @default(APPLIED)

  deliverableLinks    Json?
  revisionCount       Int                 @default(0)
  revisionRequest     Json?
  approvedAt          DateTime?
  deliverableNotes    String?

  appliedAt           DateTime            @default(now())
  offeredAt           DateTime?
  acceptedAt          DateTime?
  startedAt           DateTime?
  deliveredAt         DateTime?
  cancelledAt         DateTime?
  paidAt              DateTime?

  revisionRequestedBy String?
  revisionDeadline    DateTime?

  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  campaign            Campaign            @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  creator             CreatorProfile      @relation("CreatorCollaborations", fields: [creatorId], references: [id])
  business            BusinessProfile     @relation("BusinessCollaborations", fields: [businessId], references: [id])
  payment             Payment?
  reviews             Review[]
  dispute             Dispute?

  @@index([campaignId, status])
  @@index([creatorId, status])
  @@index([businessId, status])
  @@index([status, updatedAt])
  @@map("collaborations")
}

// ─── Payments & Escrow ──────────────────────────────────────────────

model Payment {
  id                  String       @id @default(cuid())
  collaborationId     String       @unique
  businessId          String
  creatorId           String

  grossAmount         Decimal      @db.Decimal(12, 2)
  platformFeeAmount   Decimal      @db.Decimal(12, 2)
  platformFeePercent  Decimal      @db.Decimal(5, 2)
  netAmountToCreator  Decimal      @db.Decimal(12, 2)
  currency            String       @default("INR")

  razorpayOrderId     String?      @unique
  razorpayPaymentId   String?      @unique
  razorpayReleaseId   String?      @unique
  escrowStatus        PaymentStatus @default(PENDING)

  gatewayResponse     Json?

  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  releasedAt          DateTime?
  refundedAt          DateTime?

  collaboration       Collaboration @relation(fields: [collaborationId], references: [id])
  escrowTransactions  EscrowTransaction[]
  platformFee         PlatformFee?

  @@index([businessId, escrowStatus])
  @@index([creatorId, escrowStatus])
  @@map("payments")
}

model EscrowTransaction {
  id              String         @id @default(cuid())
  paymentId       String
  type            String
  amount          Decimal        @db.Decimal(12, 2)
  gatewayEventId  String?
  status          PaymentStatus  @default(PENDING)
  gatewayResponse Json?
  createdAt       DateTime       @default(now())

  payment Payment @relation(fields: [paymentId], references: [id])

  @@index([paymentId])
  @@map("escrow_transactions")
}

model PlatformFee {
  id              String      @id @default(cuid())
  paymentId       String      @unique
  feeType         String
  amount          Decimal     @db.Decimal(12, 2)
  percentage      Decimal?    @db.Decimal(5, 2)
  netRevenue      Decimal     @db.Decimal(12, 2)
  settlementStatus String    @default("PENDING")
  settledAt       DateTime?
  createdAt       DateTime    @default(now())

  payment Payment @relation(fields: [paymentId], references: [id])

  @@map("platform_fees")
}

// ─── Chat ───────────────────────────────────────────────────────────

model ChatThread {
  id                       String   @id @default(cuid())
  creatorId                String
  businessId               String
  campaignId               String?

  isActive                 Boolean  @default(true)
  closedAt                 DateTime?

  offPlatformContactDetected Boolean @default(false)
  warningCount             Int      @default(0)

  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  creator   CreatorProfile @relation(fields: [creatorId], references: [id])
  business  BusinessProfile @relation(fields: [businessId], references: [id])
  campaign  Campaign?       @relation(fields: [campaignId], references: [id])
  messages  Message[]
  report    Report?

  @@unique([creatorId, businessId, campaignId])
  @@index([creatorId])
  @@index([businessId])
  @@map("chat_threads")
}

model Message {
  id            String      @id @default(cuid())
  threadId      String
  senderId      String
  content       String
  messageType   String       @default("text")
  mediaUrls     String[]     @default([])

  isFlagged     Boolean      @default(false)
  flagReason    String?
  isDeleted     Boolean      @default(false)

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  thread ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender User       @relation("SenderMessages", fields: [senderId], references: [id])

  @@index([threadId, createdAt])
  @@index([senderId])
  @@map("messages")
}

// ─── Reviews ────────────────────────────────────────────────────────

model Review {
  id              String       @id @default(cuid())
  collaborationId String
  reviewerId      String
  revieweeId      String
  type            ReviewType

  overallRating   Int
  criteriaRatings Json

  comment         String?
  isPublic        Boolean       @default(true)
  businessResponse String?

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  collaboration Collaboration @relation(fields: [collaborationId], references: [id])
  reviewer      User           @relation("Reviewer", fields: [reviewerId], references: [id])
  reviewee      User           @relation("Reviewee", fields: [revieweeId], references: [id])

  @@unique([collaborationId, reviewerId])
  @@index([revieweeId, type])
  @@index([collaborationId])
  @@map("reviews")
}

// ─── Disputes ───────────────────────────────────────────────────────

model Dispute {
  id              String          @id @default(cuid())
  collaborationId String          @unique
  campaignId      String
  initiatedBy     String
  assignedTo      String?
  reason          String
  category        String
  status          DisputeStatus   @default(OPEN)
  outcome         DisputeOutcome?

  creatorEvidence Json?
  businessEvidence Json?

  resolutionNotes String?
  resolvedAt      DateTime?
  amountRefunded  Decimal?        @db.Decimal(12, 2)
  amountReleased  Decimal?        @db.Decimal(12, 2)

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  collaboration Collaboration @relation(fields: [collaborationId], references: [id])
  campaign     Campaign        @relation(fields: [campaignId], references: [id])
  initiator    User            @relation("DisputeInitiator", fields: [initiatedBy], references: [id])
  resolver     User?           @relation("DisputeResolver", fields: [assignedTo], references: [id])

  @@index([status, assignedTo])
  @@map("disputes")
}

// ─── Reports ────────────────────────────────────────────────────────

model Report {
  id          String          @id @default(cuid())
  reporterId  String
  chatThreadId String         @unique
  reason      ChatReportReason
  description String?
  status      String          @default("PENDING")
  resolvedAt  DateTime?
  createdAt   DateTime        @default(now())

  reporter User       @relation("Reporter", fields: [reporterId], references: [id])
  thread   ChatThread @relation(fields: [chatThreadId], references: [id])

  @@index([reporterId])
  @@map("reports")
}

// ─── Notifications ──────────────────────────────────────────────────

model Notification {
  id          String               @id @default(cuid())
  userId      String
  type        String
  title       String
  body        String
  data        Json?
  channels    NotificationChannel[]
  readAt      DateTime?
  createdAt   DateTime             @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([createdAt])
  @@map("notifications")
}
