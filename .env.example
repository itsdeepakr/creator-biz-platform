# Application
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/creator_biz_platform?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/creator_biz_platform?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Razorpay (Indian payments)
RAZORPAY_KEY_ID=rzp_test_xxxxx
RAZORPAY_KEY_SECRET=xxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxx

# Email (SendGrid)
SENDGRID_API_KEY=xxxxx
EMAIL_FROM=noreply@creatorbizplatform.com

# AWS S3 (for file uploads)
AWS_ACCESS_KEY_ID=xxxxx
AWS_SECRET_ACCESS_KEY=xxxxx
AWS_REGION=ap-south-1
AWS_S3_BUCKET=creator-biz-uploads

# Frontend URLs (for CORS)
ADMIN_APP_URL=http://localhost:3001
CREATOR_APP_URL=http://localhost:3002
BUSINESS_APP_URL=http://localhost:3003

# Social OAuth (optional)
GOOGLE_CLIENT_ID=xxxxx
GOOGLE_CLIENT_SECRET=xxxxx
INSTAGRAM_CLIENT_ID=xxxxx
INSTAGRAM_CLIENT_SECRET=xxxxx
YOUTUBE_CLIENT_ID=xxxxx
YOUTUBE_CLIENT_SECRET=xxxxx

# Rate limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100
